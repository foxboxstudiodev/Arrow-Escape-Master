# Operating system files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# GDevelop / local temporary exports
exports/android/**/*.apk
exports/android/**/*.aab
exports/android/**/*.apks

# Android signing keys — never commit
*.keystore
*.jks
*.p12
*.pem
*.key

# Secrets and local environment files
.env
.env.*
!.env.example

# Large or generated temporary files
tmp/
temp/
build/
dist/
.cache/

# IDE files
.vscode/
.idea/

# Node dependencies if website later uses a framework
node_modules/

# Keep folder placeholders if needed
!.gitkeep
